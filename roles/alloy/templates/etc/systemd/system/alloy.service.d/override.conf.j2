# Systemd drop-in override for Alloy service
# This file overrides specific settings from the package-installed service

[Service]
# Override user and group
User={{ alloy_user }}
Group={{ alloy_group }}

# Override configuration file path
{# IPv6 addresses need brackets in host:port, or alloy rejects the flag #}
{% set _http_addr = alloy_server_http_listen_address | default('0.0.0.0') %}
{% set _grpc_addr = alloy_server_grpc_listen_address | default('0.0.0.0') %}
{% set _http_addr = ('[' ~ _http_addr ~ ']') if ':' in _http_addr and not _http_addr.startswith('[') else _http_addr %}
{% set _grpc_addr = ('[' ~ _grpc_addr ~ ']') if ':' in _grpc_addr and not _grpc_addr.startswith('[') else _grpc_addr %}
ExecStart=
ExecStart=/usr/bin/alloy run {{ alloy_config_file }} --storage.path={{ alloy_storage_path }}{% if alloy_web_server_enabled | default(true) %} --server.http.listen-addr={{ _http_addr }}:{{ alloy_port | default('12345') }}{% endif %}{% if alloy_grpc_server_enabled | default(false) %} --server.grpc.listen-addr={{ _grpc_addr }}:{{ alloy_grpc_port | default('12346') }}{% endif %}

# Override environment file
EnvironmentFile={{ alloy_env_file }}

# Override security settings for custom paths
ReadWritePaths={{ alloy_storage_path }} /var/log/alloy

{% if alloy_log_file | default('') | length > 0 %}
# Alloy logs to stderr; systemd appends it to the file instead of the journal
ReadWritePaths={{ alloy_log_file | dirname }}
StandardOutput=append:{{ alloy_log_file }}
StandardError=append:{{ alloy_log_file }}
{% endif %}

# Resource limits
{% if alloy_max_memory | default('') | length > 0 %}
MemoryMax={{ alloy_max_memory }}
{% endif %}
{% if alloy_max_cpu | default('') | length > 0 %}
CPUQuota={{ alloy_max_cpu }}
{% endif %}
